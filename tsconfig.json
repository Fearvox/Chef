{
	"extends": ["@tsconfig/strictest/tsconfig.json"],
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"composite": true,
		"strict": true,
		"downlevelIteration": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": true,
		"baseUrl": ".",
		"paths": {
			"@chef/*": ["packages/*/src"]
		}
	}
}
